# Local Docker Compose example only. Copy to .env, replace placeholders, and keep .env out of Git.
# Never reuse these example values in a shared environment. Use a URL-safe random password.
APP_ENV=development
POSTGRES_DB=crownd
POSTGRES_USER=crownd
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-value
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Local same-origin web/API routing. Frontend variables are public, never put secrets in VITE_*.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:8080
TRUSTED_HOSTS=localhost,127.0.0.1,::1
TRUSTED_PROXY_IPS=172.28.240.10
# This is the web container's fixed address on the local Compose network below.
# Production values must identify only actual immediate proxy peers.
FORWARDED_ALLOW_IPS=172.28.240.10
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Local mode defaults to no external email. To use the optional Mailpit profile, use
# EMAIL_MODE=smtp, SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_STARTTLS=false.
EMAIL_MODE=disabled
EMAIL_FROM=CROWND <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10

# Single-process local development only. Production requires a TLS shared Redis URL (rediss://).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://

LOG_LEVEL=INFO
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
WORKER_HEARTBEAT_FILE=/tmp/crownd-worker-heartbeat
