# Local development defaults. Use a new, randomly generated JWT_SECRET outside local use.
APP_ENV=development
DATABASE_URL=sqlite:///./crownd.db
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,::1,testserver
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Uvicorn's forwarded-header trust list; set only immediate proxy peers in deployments.
FORWARDED_ALLOW_IPS=127.0.0.1,::1
RATE_LIMIT_ENABLED=true
# Local memory limiter is for single-process development only. Production requires Redis/shared storage.
RATE_LIMIT_STORAGE_URI=memory://
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO
WORKER_HEARTBEAT_FILE=/tmp/crownd-worker-heartbeat
EMAIL_MODE=disabled
EMAIL_FROM=CROWND <no-reply@localhost>
# To deliver mail, set EMAIL_MODE=smtp plus SMTP_HOST/PORT/USERNAME/PASSWORD and use a TLS-capable SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
# Run `python -m app.worker` as a separate process with this same DATABASE_URL/JWT_SECRET/SMTP config.
# Queued mail is encrypted with a key derived from JWT_SECRET; drain pending messages before rotation.
VERIFICATION_TOKEN_HOURS=24
PASSWORD_RESET_TOKEN_MINUTES=30
ATTRIBUTION_DAYS=7
MINIMUM_PAYOUT=500.00
